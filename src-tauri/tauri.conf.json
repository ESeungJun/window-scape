{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "창밖날씨",
  "mainBinaryName": "window-scape",
  "version": "0.2.1",
  "identifier": "dev.haul.windowscape",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx vite --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "창밖날씨",
        "width": 440,
        "height": 320,
        "minWidth": 260,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Weather",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMDBCQUJCQjEyOTIwNkYKUldSdklDbXh1N29BS3V2ZEZIMlV0MUViaVFTZTkwSXk1WVJQa01NNFhoM1RWLytGbkpUdCs1SGoK",
      "endpoints": [
        "https://github.com/ESeungJun/window-scape/releases/latest/download/latest.json"
      ]
    }
  }
}
