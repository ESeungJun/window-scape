{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "위젯 창: 기본 권한 + 창 끌어 옮기기·크기 조절 + 업데이트 확인·설치 후 재시작",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
